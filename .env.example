# Copie este archivo como .env y reemplace los valores. Nunca suba .env al repositorio.

# PostgreSQL 16
POSTGRES_DB=banco
POSTGRES_USER=banco
POSTGRES_PASSWORD=cambie-esta-clave

# Firma de los tokens de sesión (JWT). Use una cadena larga y aleatoria.
JWT_SECRET=cambie-este-secreto

# true: muestra el inicio de sesión simulado con personas ficticias (solo para demostración).
DEMO_LOGIN=true

# Puerto local donde queda disponible la aplicación.
API_PORT=3000
